MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_string
PORT=5000
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed:admin` to create the admin account.
# Not read anywhere else, and not exposed through any public route.
ADMIN_NAME=Cooperative Admin
ADMIN_EMAIL=admin@exclusivecooperative.com
ADMIN_PASSWORD=choose_a_strong_password
# EmailJS password-reset email configuration
EMAILJS_SERVICE_ID=service_d56cryw
EMAILJS_TEMPLATE_ID=template_srm10cd
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Optional: EmailJS private key for REST API requests
EMAILJS_PRIVATE_KEY=your_emailjs_private_key


# Dojah KYC
# Keep the secret key ONLY on the backend (Render). Never put it in the website or mobile app.
#
# Sandbox vs live is decided by DOJAH_BASE_URL alone:
#   https://sandbox.dojah.io  -> testing (Dojah returns dummy identity data)
#   https://api.dojah.io      -> live (real BVN / ID / selfie checks)
# When you go live, change DOJAH_BASE_URL, DOJAH_APP_ID and DOJAH_SECRET_KEY to your
# live values, and set VITE_DOJAH_WIDGET_URL (frontend) to your live widget link.
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=your_dojah_app_id
DOJAH_SECRET_KEY=your_dojah_secret_key
# Optional extra secret used to hash BVNs before storage (used to spot one BVN on two accounts).
BVN_HASH_PEPPER=replace_with_a_long_random_value

# --- Ledger / accounting (added) ---
# Posts every money movement to the double-entry ledger. KEEP FALSE until the
# ledger has been fully implemented and tested on staging (backfill + verify).
# Dividends do NOT depend on the ledger; they use stored repayment interest.
LEDGER_ENABLED=false
# Set to true in production (MongoDB Atlas) so a missing replica set is a hard
# error instead of silently running without database transactions.
REQUIRE_DB_TRANSACTIONS=false

# Four-eyes control: when true, the admin who approved a loan cannot disburse
# it, and a dividend distribution must be approved by a different admin than
# the one who calculated it before anyone can be paid. Needs 2+ admins.
MAKER_CHECKER=false

# Email sign-in verification code (6 digits, emailed after email + password)
# Leave LOGIN_OTP_ENABLED unset/false until the EmailJS template below exists
# and the new website + mobile app versions are live.
LOGIN_OTP_ENABLED=false
# Also require the code for the admin account (recommended once email delivery is proven)
LOGIN_OTP_ADMINS=false
# Second EmailJS template: variables {{email}} {{name}} {{code}} {{expires_minutes}}
EMAILJS_OTP_TEMPLATE_ID=
# Only needed if the OTP template is in a DIFFERENT EmailJS account from the
# password-reset one. Use the service ID + keys of the account that owns it.
EMAILJS_OTP_SERVICE_ID=
EMAILJS_OTP_PUBLIC_KEY=
EMAILJS_OTP_PRIVATE_KEY=

# Website (browser) push notifications. Generate once with:
#   npx web-push generate-vapid-keys
# Keep the private key secret (Render only). Changing the pair later makes every
# member re-enable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@exclusivecooperative.com

# "Successful login" alerts (in-app + push on every login; PIN logins at most
# once per 30 minutes). Set LOGIN_ALERT_EMAIL_ENABLED=true to also email the
# member (needs a third EmailJS template, see EMAILJS_LOGIN_ALERT_TEMPLATE_ID).
LOGIN_ALERTS_ENABLED=true
LOGIN_ALERT_EMAIL_ENABLED=false
EMAILJS_LOGIN_ALERT_TEMPLATE_ID=
# Text message for every login (costs SMS credit): leave false
SMS_LOGIN_ALERTS=false

# USSD extras (both OFF until set to true; the extra menu items only appear when on)
USSD_WITHDRAWALS_ENABLED=false
USSD_WITHDRAW_REQUIRE_NAME_MATCH=true
USSD_WITHDRAW_DAILY_LIMIT=100000
USSD_PAYMENTS_ENABLED=false
USSD_PAYMENT_METHOD=transfer
USSD_TRANSFER_EXPIRY_MINUTES=
USSD_PAYMENT_REQUESTS_PER_HOUR=

# USSD loan application (menu option 6). Off = option 6 stays the read-only loan limit.
USSD_LOANS_ENABLED=false

# Office staff accounts for the admin page (created with: node scripts/staffAdmin.js create).
# Each can hold several comma-separated emails; names are optional and match by position.
# The main administrator (ADMIN_EMAIL) keeps full access and is never changed by this tool.
STAFF_MEMBERSHIP_EMAIL=
STAFF_CASH_EMAIL=
STAFF_LOAN_EMAIL=
STAFF_DISBURSEMENT_EMAIL=
STAFF_FINANCE_EMAIL=
STAFF_SUPERVISOR_EMAIL=
# Leave this unset: each account then gets its own random temporary password.
# STAFF_TEMP_PASSWORD=
