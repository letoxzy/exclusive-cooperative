MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_string
PORT=5000
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed:admin` to create the admin account.
# Not read anywhere else, and not exposed through any public route.
ADMIN_NAME=Cooperative Admin
ADMIN_EMAIL=admin@exclusivecooperative.com
ADMIN_PASSWORD=choose_a_strong_password
# EmailJS password-reset email configuration
EMAILJS_SERVICE_ID=service_d56cryw
EMAILJS_TEMPLATE_ID=template_srm10cd
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Optional: EmailJS private key for REST API requests
EMAILJS_PRIVATE_KEY=your_emailjs_private_key


# Dojah KYC
# Keep the secret key ONLY on the backend (Render). Never put it in the website or mobile app.
#
# Sandbox vs live is decided by DOJAH_BASE_URL alone:
#   https://sandbox.dojah.io  -> testing (Dojah returns dummy identity data)
#   https://api.dojah.io      -> live (real BVN / ID / selfie checks)
# When you go live, change DOJAH_BASE_URL, DOJAH_APP_ID and DOJAH_SECRET_KEY to your
# live values, and set VITE_DOJAH_WIDGET_URL (frontend) to your live widget link.
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=your_dojah_app_id
DOJAH_SECRET_KEY=your_dojah_secret_key
# Optional extra secret used to hash BVNs before storage (used to spot one BVN on two accounts).
BVN_HASH_PEPPER=replace_with_a_long_random_value
